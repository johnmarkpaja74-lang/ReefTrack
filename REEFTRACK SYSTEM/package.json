{
  "name": "reeftrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-scanner.mjs && vite build --config vite.qrcode.dev.config.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-scanner.mjs",
    "build": "tsc -b && vite build && node scripts/copy-static.mjs && vite build --config vite.qrcode.config.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@phosphor-icons/react": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.7.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
